rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdminEmail() {
      return signedIn() && request.auth.token.email == 'admin@gmail.com';
    }

    function isAdmin() {
      return isAdminEmail() ||
          (signedIn() &&
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isCommittee() {
      return signedIn() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'committee';
    }

    function canManageEvents() {
      return isAdmin() || isCommittee();
    }

    function canManageMembers() {
      return isAdmin() || isCommittee();
    }

    function hasMemberAccess() {
      return canManageMembers() ||
          (signedIn() &&
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.get('membershipStatus', 'approved') == 'approved');
    }

    match /users/{userId} {
      allow create: if (isOwner(userId) &&
              request.resource.data.role == 'member' &&
              request.resource.data.membershipStatus == 'pending') ||
          (isOwner(userId) &&
              isAdminEmail() &&
              request.resource.data.role == 'admin');
      allow read: if isOwner(userId) || canManageMembers();
      allow update: if isAdmin() ||
          (canManageMembers() &&
              request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['membershipStatus', 'reviewedBy', 'reviewedAt',
                    'rejectionReason', 'updatedAt']) &&
              request.resource.data.membershipStatus in ['approved', 'rejected']) ||
          (isOwner(userId) &&
              resource.data.role == 'member' &&
              request.resource.data.role == 'member' &&
              request.resource.data.get('membershipStatus', 'approved') ==
                  resource.data.get('membershipStatus', 'approved'));
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /events/{eventId} {
      allow read: if hasMemberAccess();
      allow create, update, delete: if canManageEvents();
    }

    match /announcements/{announcementId} {
      allow read: if hasMemberAccess();
      allow create, update, delete: if isAdmin();
    }

    match /feedbacks/{feedbackId} {
      // Approved members can submit their own feedback.
      allow create: if hasMemberAccess() &&
          request.resource.data.userId == request.auth.uid;
      // Owners see their own feedback; event managers can evaluate all events.
      allow read: if canManageEvents() ||
          (hasMemberAccess() && resource.data.userId == request.auth.uid);
      // Only admin can update (replies, status) or delete
      allow update, delete: if isAdmin();
    }

    match /participations/{participationId} {
      allow create: if hasMemberAccess() && request.resource.data.userId == request.auth.uid;
      allow read: if hasMemberAccess() && (resource == null || resource.data.userId == request.auth.uid || canManageEvents());
      allow update: if hasMemberAccess() && (
        (resource.data.userId == request.auth.uid &&
         request.resource.data.userId == request.auth.uid &&
         (request.resource.data.status == resource.data.status || request.resource.data.status == 'pending')) ||
        canManageEvents()
      );
      allow delete: if hasMemberAccess() && (resource.data.userId == request.auth.uid || canManageEvents());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

